var R1 = 100;
var R2 = 25;

var K1 = 0.5
var K2 = 1

var SCREEN_WIDTH = 1024;
var SCREEN_HEIGHT = 768;

fun x3D(x, y, cosA, cosB, sinA, sinB, cosPhi, sinPhi){
    vx = sinPhi * cosB * x;
    vy = cosPhi * y;
    return vx + vy
}


fun y3D(x, y, cosA, cosB, sinA, sinB, cosPhi, sinPhi){
    vx =  ( sinB*cosC - cosPhi*cosB*sinC ) * x;
    vy = sinPhi * sinC * y;
    return vx + vy
}

fun z3D(x, y, cosA, cosB, sinA, sinB, cosPhi, sinPhi)={
   vx = -cosPhi cosB cosB - sinB sinC;
   vy = sinPhi * cosC;
   return vx + vy
}



