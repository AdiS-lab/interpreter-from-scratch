fun x3D(x, y, cA, cB, sA, sB, cPhi, sPhi){
    var vx = (cB * cPhi + sA*sB*sPhi)* x;
    var vy = -cA*sB*y;
    return vx + vy;
}

fun y3D(x, y, cA, cB, sA, sB, cPhi, sPhi){
    var vx = (sB*cPhi - sA*cB*sPhi) * x;
    var vy = cA*cB*y;
    return vx + vy;
}


fun z3D(x, y, cA, cB, sA, sB, cPhi, sPhi){
   var vx = cA * sPhi * x;
   var vy = sA * y;
   return vx + vy;
}