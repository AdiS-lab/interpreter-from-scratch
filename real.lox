                var yDonut = y3D(x, y, cosA, cosB, sinA, sinB, cosPhi, sinPhi);
                var zDonut = z3D(x, y, cosA, cosB, sinA, sinB, cosPhi, sinPhi);

                var xProj =  xDonut*K1 / (K1 + zDonut); var yProj =  yDonut*K1 / (K1 + zDonut);

                // final x, y coords
                var realXProj = SCREEN_WIDTH / 2 + xProj;
                var realYProj = SCREEN_HEIGHT / 2 - yProj; 

                var yNormal = y3D(cosTheta, sinTheta, cosA, cosB, sinA, sinB, cosPhi, sinPhi);
                var zNormal = z3D(cosTheta, sinTheta, cosA, cosB, sinA, sinB, cosPhi, sinPhi);

                // assuming light is <0,-1,1>
                var luminance = yNormal - zNormal;
                if luminance > 0 { 
