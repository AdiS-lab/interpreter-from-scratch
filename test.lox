● fun makeGreeter() {
    fun greet(name) {
      print "Hello " + name;                  
    }                                     
    return greet;
  }                                                                                                                                                            
   
  var sayHello = makeGreeter();                                                                                                                                
                                                                                                                                                             
  sayHello("Bob");
  sayHello("Alice");
  sayHello("Eve");